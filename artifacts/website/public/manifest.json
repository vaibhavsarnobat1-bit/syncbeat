{
  "name": "SyncBeat — Listen Together",
  "short_name": "SyncBeat",
  "description": "Listen to music together in real-time with friends. Sync YouTube playback instantly.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#060708",
  "theme_color": "#06b6d4",
  "orientation": "portrait-primary",
  "icons": [
    {
      "src": "/brand-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/brand-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/brand-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "categories": ["music", "entertainment", "social"],
  "screenshots": [],
  "shortcuts": [
    {
      "name": "Join a Room",
      "url": "/lobby",
      "description": "Browse and join music rooms"
    }
  ],
  "share_target": {
    "action": "/share-audio",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "files": [
        {
          "name": "audio",
          "accept": ["audio/*", "audio/mpeg", "audio/mp3", "audio/mp4", "audio/ogg", "audio/wav", "audio/aac", "audio/flac", ".mp3", ".wav", ".ogg", ".aac", ".flac", ".m4a"]
        }
      ]
    }
  }
}
